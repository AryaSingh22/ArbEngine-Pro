# ==============================================================================
# Solana Arbitrage Bot — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/solana_arb

# Redis
REDIS_URL=redis://localhost:6379

# ==============================================================================
# SOLANA RPC
# ==============================================================================
# ⚠️ IMPORTANT: The free public endpoint is heavily rate-limited and NOT suitable
# for live arbitrage trading. You MUST use a paid RPC for production.
#
# Recommended providers:
#   Helius    — https://helius.dev     (free tier available, fast)
#   QuickNode — https://quicknode.com  (reliable, WebSocket support)
#   Triton    — https://triton.one     (Solana-focused, staked connections)
#   Alchemy   — https://alchemy.com    (multi-chain, good dashboard)
#
# Example paid RPC URLs:
#   SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#   SOLANA_RPC_URL=https://YOUR_ENDPOINT.solana-mainnet.quiknode.pro/YOUR_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# RPC commitment level:
#   processed  — fastest, but transactions may be rolled back
#   confirmed  — default, good balance of speed and safety
#   finalized  — slowest, guaranteed permanent
RPC_COMMITMENT=confirmed

# Optional dedicated WebSocket endpoint for account streaming.
# Defaults to SOLANA_RPC_URL with the scheme switched to wss://.
SOLANA_WS_URL=

# ==============================================================================
# JUPITER API
# ==============================================================================
# Optional API key for the higher rate-limit api.jup.ag tier (https://portal.jup.ag).
# Without a key the bot uses the free lite-api.jup.ag host — fine for dry runs,
# rate-limited for live trading.
JUPITER_API_KEY=

# Optional explicit overrides; normally derived from JUPITER_API_KEY.
# JUPITER_SWAP_API_URL=https://api.jup.ag/swap/v1
# JUPITER_PRICE_API_URL=https://api.jup.ag/price/v3

# ==============================================================================
# ON-CHAIN PRICE STREAMING (event-driven detection)
# ==============================================================================
# Stream pool accounts over WebSocket and compute prices locally.
# Entries separated by ';'. Two formats:
#
# Constant-product pools (e.g. Raydium AMM v4) — the pool's two vault token accounts:
#   Dex:BASE-QUOTE:base_vault:quote_vault:base_decimals:quote_decimals
#   STREAMING_POOLS=Raydium:SOL-USDC:<base_vault>:<quote_vault>:9:6
#
# Concentrated-liquidity pools — the pool account itself (sqrt price decoded
# locally). BASE must be the pool's token0/tokenA, QUOTE its token1/tokenB:
#   OrcaWhirlpool:SOL-USDC:<whirlpool_address>:9:6
#   RaydiumClmm:SOL-USDC:<clmm_pool_address>:9:6
STREAMING_POOLS=

# Drop price quotes deviating more than this percentage from the per-pair
# median (requires >= 3 sources for the pair). Guards against one bad feed
# fabricating phantom arbitrage spreads.
PRICE_SANITY_MAX_DEVIATION_PCT=20

# The legacy Raydium/Orca REST stats providers serve data minutes stale and
# were removed from detection. Re-enable only for experimentation.
ENABLE_LEGACY_REST_PROVIDERS=false

# ==============================================================================
# ARBITRAGE SETTINGS
# ==============================================================================
# Minimum net profit percentage to execute a trade (after fees)
MIN_PROFIT_THRESHOLD=0.05

# Maximum position size in USD per trade
MAX_POSITION_SIZE=1000

# Maximum age (seconds) before price data is considered stale
MAX_PRICE_AGE_SECONDS=5

# ==============================================================================
# FLASH LOANS
# ==============================================================================
# Enable Solend Flash Loans for capital efficiency
# Set to 'true' to use flash loans, 'false' to trade with own capital only
ENABLE_FLASH_LOANS=true

# ==============================================================================
# TRANSACTION SETTINGS
# ==============================================================================
# Slippage tolerance in basis points (50 = 0.5%, 100 = 1%)
SLIPPAGE_BPS=50

# Priority fee in micro-lamports per compute unit.
# With DYNAMIC_PRIORITY_FEES=true (default) this is the FLOOR: the bot bids
# the 75th percentile of recent on-chain fees, clamped to [PRIORITY_FEE, 10x].
#   Low:    1,000 - 10,000    (cheap, may not land during congestion)
#   Medium: 50,000 - 100,000  (recommended for arbitrage)
#   High:   200,000+          (expensive, fastest landing)
PRIORITY_FEE=50000
DYNAMIC_PRIORITY_FEES=true

# Compute unit limit per transaction (200,000 is safe for most swaps)
COMPUTE_UNIT_LIMIT=200000

# Maximum retry attempts for failed transactions
MAX_RETRIES=3

# ==============================================================================
# JITO MEV PROTECTION (Optional)
# ==============================================================================
# Jito bundles protect your trades from being sandwich attacked by MEV bots.
# Set USE_JITO=true to enable. Requires a Jito-compatible RPC.
USE_JITO=false
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# Tip bidding. Bundles compete in a tip auction; with dynamic tips enabled the
# bot bids the configured percentile of recently landed tips (tip floor API),
# clamped between JITO_TIP_LAMPORTS (floor + offline fallback) and
# JITO_MAX_TIP_LAMPORTS.
JITO_DYNAMIC_TIPS=true
JITO_TIP_PERCENTILE=75
JITO_TIP_LAMPORTS=10000
JITO_MAX_TIP_LAMPORTS=1000000

# Never tip more than this fraction of the trade's expected profit
# (converted to lamports via the live SOL price). Tipping more than the
# trade earns is a guaranteed loss even when the trade lands.
JITO_TIP_MAX_PROFIT_FRACTION=0.5

# ==============================================================================
# API SERVER
# ==============================================================================
API_PORT=8080

# ==============================================================================
# LOGGING
# ==============================================================================
LOG_LEVEL=info
RUST_LOG=info,solana_arb_core=debug,solana_arb_collector=debug,solana_arb_api=debug

# ==============================================================================
# WALLET
# ==============================================================================
# ⚠️ CAUTION: Your private key controls your funds. Keep it secure!
# Accepted formats: Base58 string or JSON byte array [1,2,3,...]
# For production, use environment variable injection from a secrets manager
# (e.g., AWS Secrets Manager, HashiCorp Vault, or dotenv-vault).
PRIVATE_KEY=

# ==============================================================================
# DRY RUN MODE
# ==============================================================================
# Set to true for simulation (no real trades). Default is true for safety.
# Set to false ONLY when you are ready for live trading with real funds.
DRY_RUN=true
